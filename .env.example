APP_ENV=production
APP_PORT=8910
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-before-start

DATABASE_URL=postgresql+psycopg://stock:replace-me@postgres:5432/stock
POSTGRES_USER=stock
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=stock

STOCK_ROOT_HOST=/home/ubuntu/Stock
STOCK_ROOT=/data/stock
INBOX_PATH=/data/stock/inbox
SCAN_INTERVAL_SECONDS=300
WORKER_POLL_SECONDS=2
MAX_ASSETS_PER_DAY=50
MAX_UPLOADS_TOTAL_PER_DAY=50
AI_PROVIDER=mock
AI_MODEL=
AI_CONFIDENCE_THRESHOLD=0.75
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_BASE_URL=
AI_DAILY_BUDGET_USD=5

MOCK_PROVIDER_ENABLED=true
SHUTTERSTOCK_ENABLED=false
SHUTTERSTOCK_FTPS_HOST=ftps.shutterstock.com
SHUTTERSTOCK_FTPS_USER=
SHUTTERSTOCK_FTPS_PASSWORD=
SHUTTERSTOCK_FTPS_REMOTE_DIR=
POND5_ENABLED=false
ADOBE_ENABLED=false
ALAMY_ENABLED=false
STORYBLOCKS_ENABLED=false

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
